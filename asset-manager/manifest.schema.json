{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlayEconomy asset manifest",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "source_url", "status"],
        "properties": {
          "id": {"type": "string"},
          "filename": {"type": ["string", "null"]},
          "type": {"enum": ["image", "video", "audio", "graphic"]},
          "category": {"type": ["string", "null"]},
          "asset_role": {"type": ["string", "null"]},
          "final_category": {"type": ["string", "null"]},
          "final_entity": {"type": ["string", "null"]},
          "franchise": {"type": ["string", "null"]},
          "company": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "source_url": {"type": "string"},
          "creator": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]},
          "license_url": {"type": ["string", "null"]},
          "checksum": {"type": ["string", "null"]},
          "drive_path": {"type": ["string", "null"]},
          "drive_file_id": {"type": ["string", "null"]},
          "status": {"enum": ["candidate", "downloaded", "approved", "rejected", "duplicate", "error"]}
        }
      }
    }
  }
}
